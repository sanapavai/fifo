        ----------------------------------------------------------------
        wr <= '1';

        data_in <= x"11";
        wait for 10 ns;

        data_in <= x"22";
        wait for 10 ns;

        data_in <= x"33";
        wait for 10 ns;

        wr <= '0';
        wait for 20 ns;

        ----------------------------------------------------------------
        -- Read 3 values
        ----------------------------------------------------------------
        re <= '1';
        wait for 10 ns;

        wait for 10 ns;

        wait for 10 ns;

        re <= '0';
        wait for 20 ns;

        ----------------------------------------------------------------
        -- Fill FIFO
        ----------------------------------------------------------------
        wr <= '1';

        for i in 0 to 15 loop
            data_in <= std_logic_vector(to_unsigned(i,8));
            wait for 10 ns;
        end loop;

        wr <= '0';

        wait for 100 ns;
